{
  "name": "miaoda-game-sokoban-core",
  "version": "0.1.1",
  "description": "Engine-independent Sokoban rules, notation, dead-square analysis, and deterministic bounded solving.",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "dependencies": {
    "miaoda-game-grid-core": "0.3.2",
    "miaoda-game-serialization-core": "0.1.0",
    "miaoda-game-random-core": "0.1.0"
  },
  "keywords": [
    "sokoban",
    "puzzle",
    "grid",
    "solver",
    "procedural-generation",
    "cocos",
    "phaser"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "vitest run"
  }
}