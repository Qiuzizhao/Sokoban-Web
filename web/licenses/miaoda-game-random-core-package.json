{
  "name": "miaoda-game-random-core",
  "version": "0.1.0",
  "description": "Engine-independent compatibility primitives for deterministic random streams with exact serializable state.",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "keywords": [
    "random",
    "rng",
    "deterministic",
    "mulberry32",
    "replay",
    "save-game"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "vitest run"
  }
}