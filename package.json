{
  "name": "sokoban-web",
  "private": true,
  "type": "module",
  "scripts": {
    "extract": "node scripts/extract.mjs",
    "build": "node scripts/build.mjs",
    "build:single": "node scripts/build.mjs && node scripts/build-single.mjs",
    "build:first": "node scripts/build-single.mjs --first-level",
    "build:pages": "node scripts/build.mjs && node scripts/build-single.mjs --first-level --output web/first-level.html",
    "test": "node --test tests/*.test.mjs",
    "audit": "node scripts/audit.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:first": "node scripts/browser-check-first.mjs"
  },
  "dependencies": {
    "lucide": "^0.468.0",
    "miaoda-game-sokoban-core": "0.1.1"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.8.11",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0"
  }
}
